class Solution {
    public boolean isPossible(int[] nums) {
        PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> {
            if (a[0] != b[0]) {
                return a[0] - b[0];
            }
            return a[1] - b[1];
        });

        for (int num : nums) {

            while (!pq.isEmpty() && pq.peek()[0] < num - 1) {
                if (pq.poll()[1] < 3) {
                    return false;
                }
            }

            if (!pq.isEmpty() && pq.peek()[0] == num - 1) {
                int[] current = pq.poll();
                pq.add(new int[]{num, current[1] + 1});
            } else {
                pq.add(new int[]{num, 1});
            }
        }

        while (!pq.isEmpty()) {
            if (pq.poll()[1] < 3) {
                return false;
            }
        }

        return true;
    }
}
