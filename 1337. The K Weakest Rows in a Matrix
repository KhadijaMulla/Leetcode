class Solution {
    public int[] kWeakestRows(int[][] mat, int k) {

        PriorityQueue<Integer> pq =
            new PriorityQueue<>((a, b) -> {

                int countA = 0;
                int countB = 0;

                for(int x : mat[a]){
                    countA += x;
                }

                for(int x : mat[b]){
                    countB += x;
                }

                if(countA != countB){
                    return countA - countB;
                }

                return a - b;
            });

        for(int i = 0; i < mat.length; i++){
            pq.add(i);
        }

        int[] ans = new int[k];

        for(int i = 0; i < k; i++){
            ans[i] = pq.poll();
        }

        return ans;
    }
}
