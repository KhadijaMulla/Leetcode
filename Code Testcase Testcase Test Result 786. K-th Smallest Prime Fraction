class Solution {
    public int[] kthSmallestPrimeFraction(int[] arr, int k) {

        PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) ->
            arr[a[0]] * arr[b[1]] - arr[b[0]] * arr[a[1]]
        );

        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            pq.add(new int[]{i, n - 1});
        }

        while (k > 1) {
            int[] current = pq.poll();

            int i = current[0];
            int j = current[1];

            if (j - 1 > i) {
                pq.add(new int[]{i, j - 1});
            }

            k--;
        }

        int[] ans = pq.peek();

        return new int[]{arr[ans[0]], arr[ans[1]]};
    }
}

