class Solution {
    public int nthUglyNumber(int n) {
        PriorityQueue<Long>pq=new PriorityQueue<>();
        HashSet<Long>set=new HashSet<>();
        pq.add(1L);
        set.add(1L);

        for(int i=0;i<n-1;i++){
            Long k=pq.poll();
            if(!set.contains(k*2)){
                pq.add(k*2);
                set.add(k*2);
            }

            if(!set.contains(k*3)){
                pq.add(k*3);
                set.add(k*3);
            }
            if(!set.contains(k*5)){
                pq.add(k*5);
                set.add(k*5);
            }
            
        }
        return pq.peek().intValue();
    
    }
}




